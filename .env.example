# Copy this file to ".env" for local development.
# On Vercel, add the same variable under Project Settings -> Environment Variables.
# Variables prefixed with VITE_ are bundled into the public website, so never put
# passwords, private keys or API secrets here.

# Contact form endpoint (for example a Formspree form URL).
# Leave empty to show the contact form as "not configured yet".
# Format: https://formspree.io/f/<your-form-id>
VITE_FORM_ENDPOINT=
